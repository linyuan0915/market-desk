RSSCAST_MCP_TOKEN=replace_with_rsscast_token

# iFinD 同花顺量化 API。不要把真实账号密码提交到 Git。
IFIND_USERNAME=
IFIND_PASSWORD=
IFIND_HISTORY_FIELDS=open;high;low;close;volume;amount
IFIND_HISTORY_OPTIONS=Interval:D,CPS:1,baseDate:1900-01-01,Currency:YSHB,Fill:Previous

MARKET_DB_HOST=127.0.0.1
MARKET_DB_PORT=3306
MARKET_DB_USER=root
MARKET_DB_PASSWORD=
MARKET_DATA_DB=market_data

APP_PASSWORD=replace_with_login_password
APP_SESSION_SECRET=replace_with_long_random_secret
APP_COOKIE_SECURE=1
API_CACHE_TTL_SECONDS=900
